<?xml version="1.0" encoding="UTF-8"?>
<!--
  集成测试用的日志配置。

  ★ 为什么需要它：不加配置时 logback 的根级别是 DEBUG，MyBatis 会把每条 SQL、
  每个参数都打出来 —— 一次全量测试能刷出几万行，真正的「Tests run / 失败原因」
  被彻底淹没（实测吃过这个亏：一次跑完根本看不到哪条断言红的）。

  这里把根级别收到 WARN，只留测试框架自己的 INFO 摘要与失败堆栈。
  需要排查某条 SQL 时，把对应包临时调成 DEBUG 即可，例如：
      <logger name="org.jeecg.modules.land.archive.ledger.mapper" level="DEBUG"/>
-->
<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 测试框架的摘要与回滚信息保留在 INFO -->
    <logger name="org.springframework.test" level="INFO"/>
    <!-- MyBatis / MyBatis-Plus 的 SQL 明细默认关掉 -->
    <logger name="org.jeecg.modules.land" level="WARN"/>
    <logger name="org.mybatis" level="WARN"/>
    <logger name="com.baomidou" level="WARN"/>

    <root level="WARN">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
