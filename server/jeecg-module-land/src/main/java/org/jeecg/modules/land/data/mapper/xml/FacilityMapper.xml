<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.land.data.mapper.FacilityMapper">

    <!--
      市政配套项目 Mapper（表 t_supporting_facilities，列结构沿用旧系统配套表）
      注意：本表的审计列是驼峰（delFlag / createTime / createAccount），
            查询时若要过滤删除状态，列名必须写 delFlag 而不是 del_flag。
    -->

    <sql id="optionColumns">
        f.`id`      AS id,
        f.`ptxmmc`  AS ptxmmc,
        f.`crzdbh`  AS crzdbh,
        f.`dkmc`    AS dkmc,
        f.`ptsslb`  AS ptsslb,
        f.`xzqh`    AS xzqh,
        f.`xmfl`    AS xmfl,
        f.`jsdw`    AS jsdw
    </sql>

    <select id="selectOptions" resultType="org.jeecg.modules.land.data.vo.FacilityOptionVO">
        SELECT <include refid="optionColumns"/>
        FROM `t_supporting_facilities` f
        WHERE COALESCE(f.`delFlag`, '0') = '0'
          AND f.`crzdbh` = #{crzdbh}
        <if test="keyword != null and keyword != ''">
            AND f.`ptxmmc` LIKE CONCAT('%', #{keyword}, '%')
        </if>
        ORDER BY f.`ptxmmc`
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <!--
      跨宗地的配套项目搜索（档案查询的条件、录入弹窗的「打开就能选到道路类」）。

      ★ P1-10：新增两个**可选**参数，两个都不传时 SQL 与改动前逐字等价
      （同样的 WHERE、同样的 ORDER BY f.crzdbh, f.ptxmmc、同样的 LIMIT）：
        · category  —— 按 ptsslb 模糊过滤（传「道路」= ptsslb LIKE '%道路%'）；
        · roadFirst —— true 时把「名称或类别里带道路」的排到前面。
      为什么要 roadFirst 而不是让前端对取回的 N 条本地排序：
        1433 条配套里道路只占一小撮，按 crzdbh 排序后前 50 条经常一条道路都没有，
        前端对「已经取回的 50 条」排序等于在错的候选集里排序，永远排不出道路来。
        排序必须在 SQL 里做，才能保证「LIMIT 之前」就把道路挑出来。
    -->
    <select id="searchOptions" resultType="org.jeecg.modules.land.data.vo.FacilityOptionVO">
        SELECT <include refid="optionColumns"/>
        FROM `t_supporting_facilities` f
        <where>
            COALESCE(f.`delFlag`, '0') = '0'
            <if test="keyword != null and keyword != ''">
                AND
                (f.`ptxmmc` LIKE CONCAT('%', #{keyword}, '%')
                 OR f.`crzdbh` LIKE CONCAT('%', #{keyword}, '%'))
            </if>
            <!-- 配套类别模糊匹配：字典里的写法是「道路工程」「道路」等，用户传「道路」即可命中 -->
            <if test="category != null and category != ''">
                AND f.`ptsslb` LIKE CONCAT('%', #{category}, '%')
            </if>
        </where>
        <choose>
            <when test="roadFirst">
                <!--
                  「道路类」判定放在 ORDER BY 的 CASE 里：名称里带「道路」或类别里带「道路」都算。
                  这里把 '%道路%' 写成字面量而不是参数，是因为它是业务口径（前端不传这个关键字，
                  它是「优先展示道路类」这条规则本身），传参反而会让人以为可以随便换词。
                  CASE 之后的 crzdbh / ptxmmc 保证同组内顺序稳定、分页不抖。
                -->
                ORDER BY CASE
                             WHEN f.`ptxmmc` LIKE '%道路%' OR f.`ptsslb` LIKE '%道路%' THEN 0
                             ELSE 1
                         END,
                         f.`crzdbh`, f.`ptxmmc`
            </when>
            <otherwise>
                ORDER BY f.`crzdbh`, f.`ptxmmc`
            </otherwise>
        </choose>
        <!-- limit=0 是移交/台账下拉的全量契约；缺省仍由 Service 截到 50 条。 -->
        <if test="limit != null">
            LIMIT #{limit}
        </if>
    </select>

    <select id="selectByPtxmmc" resultType="org.jeecg.modules.land.data.entity.Facility">
        SELECT * FROM `t_supporting_facilities`
        WHERE COALESCE(`delFlag`, '0') = '0' AND `ptxmmc` = #{ptxmmc}
        LIMIT 1
    </select>

    <select id="countByCrzdbh" resultType="long">
        SELECT COUNT(1) FROM `t_supporting_facilities`
        WHERE COALESCE(`delFlag`, '0') = '0' AND `crzdbh` = #{crzdbh}
    </select>

    <!--
      说明：首页看板的统计片段（actionableCondition / warningRates）与
      selectDashboardOverview / selectDashboardRanks / selectDistrictGroups /
      selectWarningByProjectType / selectLandWarnings 已整体迁到
      stat/home/mapper/xml/HomeStatMapper.xml，本文件不再保留第二份口径。

      原 selectWarningDetails（首页预警行「查看」的配套明细）同样已迁走，
      换成 stat/home 的 selectWarningLands：它按宗地聚合、与预警行共用
      warningRates，并且区级用 xzqh2 过滤（旧实现用 xzqh，区级点开永远是空表）。
    -->

    <!-- 数据版本：全表 MAX(updateTime)。不过滤 delFlag——移除/恢复也会刷新
         该行 updateTime，概览缓存必须随之失效（列名驼峰，本表惯例） -->
    <select id="selectMaxUpdateTime" resultType="java.util.Date">
        SELECT COALESCE(MAX(`updateTime`), '1970-01-01 00:00:00') FROM `t_supporting_facilities`
    </select>

    <!-- 批量更新配套地块图形（配套 GeoJSON 导入专用）：多语句分号分隔，
         依赖 JDBC URL 的 allowMultiQueries=true；调用方分批（每批 ≤50 条） -->
    <update id="batchUpdateGeo">
        <foreach collection="list" item="f" separator=";">
            UPDATE `t_supporting_facilities`
            SET `dk_geojson` = #{f.dkGeojson},
                `dk_geojson_overview` = #{f.dkGeojsonOverview},
                `updateTime` = #{f.updateTime}
            WHERE `id` = #{f.id}
        </foreach>
    </update>

</mapper>
