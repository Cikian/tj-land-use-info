<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.jeecg.modules.land.data.mapper.LandMapper">

    <!--
      经营性用地（宗地）Mapper
      注意：本文件必须放在 src/main/java 下（jeecg 约定），
            mapper-locations 为 classpath*:org/jeecg/modules/**/xml/*Mapper.xml
    -->

    <select id="selectOptions" resultType="org.jeecg.modules.land.data.vo.LandOptionVO">
        SELECT
            l.`id`        AS id,
            l.`crzdbh`    AS crzdbh,
            l.`dkmc`      AS dkmc,
            l.`xzqh`      AS xzqh,
            l.`xmfl`      AS xmfl,
            (SELECT COUNT(1) FROM `t_supporting_facilities` f WHERE f.`crzdbh` = l.`crzdbh`) AS facilityCount
        FROM `t_land` l
        WHERE l.`del_flag` = 0
        <if test="xzqh != null and xzqh != ''">
            AND l.`xzqh` = #{xzqh}
        </if>
        <if test="keyword != null and keyword != ''">
            AND (l.`crzdbh` LIKE CONCAT('%', #{keyword}, '%')
                 OR l.`dkmc` LIKE CONCAT('%', #{keyword}, '%'))
        </if>
        ORDER BY l.`crzdbh`
        LIMIT #{limit}
    </select>

    <select id="countAll" resultType="long">
        SELECT COUNT(1) FROM `t_land` WHERE `del_flag` = 0
    </select>

    <!-- 数据版本：全表 MAX(update_time)。不过滤 del_flag——移除/恢复也会刷新
         该行 update_time，概览缓存必须随之失效，否则回收站里删掉的地块还在图上 -->
    <select id="selectMaxUpdateTime" resultType="java.util.Date">
        SELECT COALESCE(MAX(`update_time`), '1970-01-01 00:00:00') FROM `t_land`
    </select>

    <!-- 批量更新地块图形（GeoJSON 导入专用）：多语句分号分隔，
         依赖 JDBC URL 的 allowMultiQueries=true；调用方分批（每批 ≤50 条） -->
    <update id="batchUpdateGeo">
        <foreach collection="list" item="f" separator=";">
            UPDATE `t_land`
            SET `dk_geojson` = #{f.dkGeojson},
                `dk_geojson_overview` = #{f.dkGeojsonOverview},
                `update_by` = #{f.updateBy},
                `update_time` = #{f.updateTime}
            WHERE `id` = #{f.id}
        </foreach>
    </update>

    <select id="selectByCrzdbh" resultType="org.jeecg.modules.land.data.entity.Land">
        SELECT * FROM `t_land`
        WHERE `del_flag` = 0 AND `crzdbh` = #{crzdbh}
        LIMIT 1
    </select>

    <!--
      说明：首页宗地统计（selectDashboardOverview / selectDashboardRanks）已迁到
      stat/home/mapper/xml/HomeStatMapper.xml，本文件不再保留第二份口径。
    -->

</mapper>
