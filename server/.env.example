# =============================================================================
#  环境变量模板（提交到仓库）
# -----------------------------------------------------------------------------
#  用法：复制本文件为同目录下的 .env，填入真实值。.env 已被 .gitignore 忽略。
#
#    copy .env.example .env
#
#  ★ 哪些地方会读它（两处各自独立，都不需要额外脚本）：
#    · 启动应用：IDE 点 Run / java -jar / mvn spring-boot:run 都可以
#      → DotEnvEnvironmentPostProcessor（在 jeecg-boot-base-core）在启动最早期
#        把本文件读成**最低优先级**的 PropertySource，
#        所以 yml 里的 ${TJ_XXX} 能解析，且真环境变量与 -D 参数优先于本文件。
#      ★ 改过 jeecg-boot-base-core 后要先 `mvn -o -pl jeecg-boot-base-core install -DskipTests`，
#        否则 Maven 会用 .m2 里的旧 jar（本项目踩过一次）。
#    · 集成测试：mvn -pl jeecg-module-land test -Pit
#      → LandTestConfig 按「系统属性 → 环境变量 → 本文件」的顺序读取。
#
#    · 想用真环境变量（CI/生产）：用 scripts/run-with-env.ps1 把本文件注入进程环境，
#      或不建本文件、直接用环境变量。
#
#  ★ 语法：每行 KEY=VALUE，不要加引号、不要写 export、不要在行尾写注释
#    （值里本身可能含 @ # 等字符，加引号或行尾注释会让值带上多余字符）
#
#  ★ 留空的含义：
#    · 值留空 → 该配置项按「空」处理（例如本机 Redis 无密码）
#    · 想用代码里的默认值 → 直接删掉整行，或保留 yml 的 ${VAR:默认值} 形式
#    · 标了「必填」的项留空会让应用启动/测试**明确报错**，
#      这是刻意设计的：宁可在启动时失败，也不要拿着占位口令去连库
#      （连不上还能看出原因，写错口令去连生产库才是灾难）
# =============================================================================

# ---------- MySQL（业务库 / 中台镜像库同一个实例）----------
TJ_DB_HOST=127.0.0.1
TJ_DB_PORT=3306
TJ_DB_NAME=tj-jyxyd
TJ_DB_USER=root
# 必填。集成测试连的就是这个账号，留空会直接报错而不是静默用默认口令
TJ_DB_PASSWORD=

# ---------- Redis ----------
TJ_REDIS_HOST=127.0.0.1
TJ_REDIS_PORT=6379
# 无密码就留空（yml 里用 ${TJ_REDIS_PASSWORD:} 处理，空值不会变成字符串 "null"）
TJ_REDIS_PASSWORD=

# ---------- Druid 监控台（/druid）登录口令 ----------
# ★ 该 servlet 在配置里是 enabled: true，所以口令不是可选项。
#   旧模板把 admin/123456 直接写在仓库里，部署到公网等于不设防，务必改掉。
TJ_DRUID_LOGIN_USERNAME=admin
TJ_DRUID_LOGIN_PASSWORD=

# ---------- 中台对接专用账号（供业务侧调中台接口，不是登录用户）----------
TJ_ZK_USERNAME=system
TJ_ZK_PASSWORD=

# ---------- jeecg 签名密钥（前后端必须一致）----------
# 「正式发布请自行修改」—— 部署前务必换成自己生成的长随机串
TJ_SIGNATURE_SECRET=

# ---------- Swagger/Knife4j 文档页 Basic 认证 ----------
# config 里 knife4j.basic.enable=false，当前不生效；留空即可，需要时再配
TJ_KNIFE4J_USERNAME=
TJ_KNIFE4J_PASSWORD=

# ---------- 邮箱 ----------
TJ_MAIL_USERNAME=
TJ_MAIL_PASSWORD=

# ---------- 阿里云 OSS ----------
TJ_OSS_ACCESS_KEY=
TJ_OSS_SECRET_KEY=

# ---------- MinIO ----------
TJ_MINIO_NAME=
TJ_MINIO_PASSWORD=
