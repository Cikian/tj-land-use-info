# =============================================================================
#  环境变量模板（提交到仓库）
# -----------------------------------------------------------------------------
#  用法：复制本文件为同目录下的 .env，填入真实值。.env 已被 .gitignore 忽略。
#
#    copy .env.example .env
#
#  ★ 哪些地方会读它（两处各自独立，都不需要额外脚本）：
#    · 启动应用：IDE 点 Run / java -jar / mvn spring-boot:run 都可以
#      → DotEnvEnvironmentPostProcessor（在 jeecg-boot-base-core）在启动最早期
#        把本文件读成**最低优先级**的 PropertySource，
#        所以 yml 里的 ${TJ_XXX} 能解析，且真环境变量与 -D 参数优先于本文件。
#      ★ 改过 jeecg-boot-base-core 后要先 `mvn -o -pl jeecg-boot-base-core install -DskipTests`，
#        否则 Maven 会用 .m2 里的旧 jar（本项目踩过一次）。
#    · 集成测试：mvn -pl jeecg-module-land test -Pit
#      → LandTestConfig 按「系统属性 → 环境变量 → 本文件」的顺序读取。
#
#    · 想用真环境变量（CI/生产）：用 scripts/run-with-env.ps1 把本文件注入进程环境，
#      或不建本文件、直接用环境变量。
#
#  ★ 语法：每行 KEY=VALUE，不要加引号、不要写 export、不要在行尾写注释
#    （值里本身可能含 @ # 等字符，加引号或行尾注释会让值带上多余字符）
#
#  ★ 留空的含义：
#    · 值留空 → 该配置项按「空」处理（例如本机 Redis 无密码）
#    · 想用代码里的默认值 → 直接删掉整行，或保留 yml 的 ${VAR:默认值} 形式
#    · 标了「必填」的项留空会让应用启动/测试**明确报错**，
#      这是刻意设计的：宁可在启动时失败，也不要拿着占位口令去连库
#      （连不上还能看出原因，写错口令去连生产库才是灾难）
#
#  ★ 打包部署（`mvn clean package -Pprod`）：
#    本文件**不进 jar**，要和 jar 放在同一目录（或向上 4 级以内）一起拷过去；
#    prod 打包后用到的键是 TJ_SERVER_PORT / TJ_CONTEXT_PATH / TJ_UPLOAD_PATH 等，
#    其余键与 dev 共用。见 server/环境变量与敏感信息.md。
# =============================================================================

# ---------- 服务端口 / 上下文路径（仅 prod profile 读取，yml 里不留默认值）----------
# 本项目部署口径：9802 + /api，正好对上 nginx 的 /api/ 反代
# （code/new/docs/deploy/nginx-admin.web.conf、nginx-gis.web.conf）
TJ_SERVER_PORT=9802
TJ_CONTEXT_PATH=/api

# ---------- MySQL（业务库 / 中台镜像库同一个实例）----------
TJ_DB_HOST=127.0.0.1
TJ_DB_PORT=3306
TJ_DB_NAME=tj-jyxyd
TJ_DB_USER=root
# 必填。集成测试连的就是这个账号，留空会直接报错而不是静默用默认口令
TJ_DB_PASSWORD=
# Druid 连接池上限（模板 prod 原值是 1000，共享实例上会把连接打满）
TJ_DB_MAX_ACTIVE=50

# ---------- Redis ----------
TJ_REDIS_HOST=127.0.0.1
TJ_REDIS_PORT=6379
# 无密码就留空（yml 里用 ${TJ_REDIS_PASSWORD:} 处理，空值不会变成字符串 "null"）
TJ_REDIS_PASSWORD=
# 逻辑库序号（yml 里是 ${TJ_REDIS_DB}，**无默认值**，缺了启动即占位符解析失败）
TJ_REDIS_DB=0

# ---------- Druid 监控台（/druid）登录口令 ----------
# ★ 该 servlet 在配置里是 enabled: true，所以口令不是可选项。
#   旧模板把 admin/123456 直接写在仓库里，部署到公网等于不设防，务必改掉。
TJ_DRUID_LOGIN_USERNAME=admin
TJ_DRUID_LOGIN_PASSWORD=

# ---------- 文件存储 ----------
# local（本地上传，本项目用这个）/ minio / alioss
TJ_UPLOAD_TYPE=local
# 相对路径按「启动时的当前目录」解析；要固定位置就写绝对路径（目录会自动创建）
TJ_UPLOAD_PATH=./upFiles
TJ_WEBAPP_PATH=./upFiles/webapp

# ---------- 前端地址（拼绝对链接用）----------
TJ_DOMAIN_URL_PC=http://127.0.0.1:3100
TJ_DOMAIN_URL_APP=http://127.0.0.1:8051

# ---------- 中台 ZK-SERVER ----------
# ★ 中台没装/没起来就改成 false：否则每次新增、修改 用户·机构·角色 都会去调空地址，
#   严格模式下抛异常回滚，表现是「保存直接失败」。
TJ_ZK_ENABLED=true
# 必须带 context-path，例如 http://127.0.0.1:4548/app
TJ_ZK_BASE_URL=http://127.0.0.1:4548/app
# 中台对接专用账号（供业务侧调中台接口，不是登录用户）
TJ_ZK_USERNAME=system
TJ_ZK_PASSWORD=
# 中台登录用的固定验证码
TJ_ZK_CAPTCHA=cikian
# true=中台失败即回滚（生产口径）；中台过渡期改 false，只记日志不回滚
TJ_ZK_SYNC_STRICT=true
# disable=删除用户时停用中台账号（保守）/ physical=物理删除
TJ_ZK_USER_DELETE_MODE=physical
# 中台库名（与业务库同一实例）
TJ_ZK_DB_NAME=tj_jyxyd_zk

# ---------- jeecg 签名密钥（前后端必须一致）----------
# 「正式发布请自行修改」—— 部署前务必换成自己生成的长随机串
TJ_SIGNATURE_SECRET=

# ---------- Swagger/Knife4j 文档页 ----------
# Basic 认证默认关闭（口令为空时开着会把文档页锁死）；需要时改成 true 并填账号口令
TJ_KNIFE4J_BASIC_ENABLED=false
# true = 生产屏蔽接口文档页
TJ_KNIFE4J_PRODUCTION=false
TJ_KNIFE4J_USERNAME=
TJ_KNIFE4J_PASSWORD=

# ---------- ElasticSearch ----------
# 没部署 ES 就是 false（否则启动时会去连 9200 并等超时）
TJ_ES_CHECK_ENABLED=false
TJ_ES_CLUSTER_NODES=127.0.0.1:9200

# ---------- 空间库 PG（land.spatial.pg-*，SHP 入库 + MVT 出图共用）----------
# ★ 这四个键管的是「目标 PostgreSQL」——SHP 上传入库时写进去、MVT 出图时从它读。
#   和业务库 MySQL（TJ_DB_*）是两个实例，别混。
# 不带默认值也会用 yml 里的兜底（49.232.252.56 / 5432 / postgres），换库才需要改
TJ_PG_HOST=49.232.252.56
TJ_PG_PORT=5432
TJ_PG_USER=postgres
# 必填。yml 里写的是 ${TJ_PG_PASSWORD}（无默认值），缺了启动即占位符解析失败
TJ_PG_PASSWORD=

# ---------- SHP 上传入库（land.spatial）----------
# shp2pgsql（快，需要装 PostgreSQL 客户端）/ geotools（纯 Java，信创环境用这个）
TJ_SHP_IMPORT_ENGINE=shp2pgsql
# 留空＝自动探测 shp2pgsql（PostgreSQL 安装目录 / PATH / SHOW data_directory）
TJ_SHP2PGSQL_PATH=
# .dbf 属性文件字符集（国内数据多为 GBK；数据是 UTF-8 时改这里）
TJ_SHP_DBF_CHARSET=GBK
# shp2pgsql 输出 SQL 的读取字符集：Windows 中文环境 GBK，Linux UTF-8 环境必须改 UTF-8
TJ_SHP_SQL_CHARSET=GBK

# ---------- 提级论证（land.escalation）----------
# 结论是否回写地块/配套主表；默认 true，只在排查问题时临时改 false
TJ_ESCALATION_WRITEBACK=true

# ---------- 邮箱 ----------
TJ_MAIL_USERNAME=
TJ_MAIL_PASSWORD=

# ---------- 阿里云 OSS ----------
TJ_OSS_ACCESS_KEY=
TJ_OSS_SECRET_KEY=

# ---------- MinIO ----------
TJ_MINIO_NAME=
TJ_MINIO_PASSWORD=

# ---------- 在线预览（kkFileView）----------
# 后端 SysCommentController / 预览配置读取；必须带 http:// 或 https://。
# 例：http://192.168.1.20:8012 或 https://<业务域名>/fileview
# 本机部署保持默认值即可。
TJ_FILE_VIEW_DOMAIN=http://127.0.0.1:8012
